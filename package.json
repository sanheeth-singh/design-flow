{
  "name": "design-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build": "npm run build:runtime && npm run build --workspace @flow/web",
    "typecheck": "tsc -p tsconfig.runtime.json --noEmit && npm run typecheck --workspace @flow/web",
    "lint": "eslint .",
    "test": "npm run build:runtime && node --test tests/*.test.mjs",
    "start": "node dist/scripts/start.js",
    "coordinator": "node dist/apps/coordinator/src/main.js",
    "flow": "node dist/packages/cli/src/main.js",
    "recover": "node dist/scripts/recover.js",
    "demo:setup": "node dist/scripts/demo.js"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
